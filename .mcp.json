{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated"]
    },
    "sur9e-app": {
      "command": "node",
      "args": ["cli/mcp-app-server.mjs"],
      "env": { "SUR9E_APP_URL": "http://localhost:3000" }
    }
  }
}
